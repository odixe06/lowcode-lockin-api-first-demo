    "label": "API first demo",
    "disabled": false,
    "info": "Thin UI. Business rules and storage remain in external Python API."
  },
  {
    "id": "form-in",
    "type": "http in",
    "z": "tab-api",
    "x": 140,
    "y": 80,
    "name": "UI A",
    "url": "/demo",
    "method": "get",
